// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────

enum Role {
  ADMIN
  COMPTABLE
  EMPLOYE
}

// Comment la PME regle SES fournisseurs. A ne pas confondre avec
// PaymentProvider, qui dit comment elle paie Xaalis.
enum PaymentMethod {
  ESPECES
  WAVE
  ORANGE_MONEY
  VIREMENT
  CARTE
}

enum ExpenseStatus {
  EN_ATTENTE
  VALIDEE
}

enum OcrStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RecurringFrequency {
  MENSUELLE
  TRIMESTRIELLE
}

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
}

enum ReportStatus {
  BROUILLON
  SOUMISE
  APPROUVEE
  REJETEE
  REMBOURSEE
}

enum ApprovalAction {
  SOUMISSION
  APPROBATION
  REJET
  REMBOURSEMENT
  CORRECTION
}

enum SubscriptionPlan {
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

// Comment la PME paie SON abonnement Xaalis. Seul WAVE est implemente en V1
// (PROJET.md section 6) ; ORANGE_MONEY et STRIPE sont reserves pour la V2 et ne
// sont references nulle part dans le code. Les conserver ici ne coute rien et
// evite une migration d'enum le jour ou l'un des deux arrive.
// WAVE est le seul prestataire utilise : l'entreprise paie sur un lien du
// portefeuille marchand (PROJET.md section 9).
//
// PAYDUNYA et BAMMITE ont ete ajoutes le 16 aout 2026 lors d'une evaluation
// abandonnee, et ne sont ecrits nulle part. Ils restent parce que PostgreSQL ne
// sait pas retirer une valeur d'enum : les enlever d'ici creerait une derive
// entre le schema et la base, pour aucun gain.
enum PaymentProvider {
  WAVE
  ORANGE_MONEY
  STRIPE
  PAYDUNYA
  BAMMITE
}

// Le paiement annuel offre deux mois (PROJET.md section 11)
enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  PENDING // cree, le client n'a pas encore dit avoir paye
  AWAITING_VERIFICATION // le client declare avoir paye : reste a confirmer sur Wave Business
  SUCCEEDED
  FAILED
}

// ─────────────────────────────────────────────────────────
// Modeles
// ─────────────────────────────────────────────────────────

// id = identifiant d'organisation Clerk (org_xxx) : Clerk est la source de verite
model Organization {
  id       String  @id
  name     String
  logo     String?
  currency String  @default("XOF")
  settings Json?

  // Suppression en deux temps (choix produit) : le webhook Clerk pose cette
  // date, l'entreprise devient aussitot inaccessible, et la purge efface tout
  // 30 jours plus tard. Un registre comptable ne s'efface pas sur un clic.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       Membership[]
  categories        Category[]
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  budgets           Budget[]
  expenseReports    ExpenseReport[]
  subscription      Subscription?
  payments          Payment[]
  ocrUsages         OcrUsage[]
  auditLogs         AuditLog[]
}

// userId = identifiant Clerk (pas de table User locale : Clerk est la source de verite)
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  codeSyscohada  String?
  color          String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]
  budgets      Budget[]

  @@index([organizationId])
}

model Expense {
  id             String        @id @default(cuid())
  organizationId String
  amount         Int
  date           DateTime
  categoryId     String
  supplier       String?
  paymentMethod  PaymentMethod
  description    String?
  status         ExpenseStatus @default(EN_ATTENTE)
  createdById    String
  reportId       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category       @relation(fields: [categoryId], references: [id])
  report       ExpenseReport? @relation(fields: [reportId], references: [id])
  receipts     Receipt[]

  @@index([organizationId])
  @@index([reportId])
  @@index([categoryId])
}

model Receipt {
  id         String    @id @default(cuid())
  expenseId  String
  fileUrl    String
  ocrData    Json?
  ocrStatus  OcrStatus @default(PENDING)
  confidence Float?
  createdAt  DateTime  @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model RecurringExpense {
  id             String             @id @default(cuid())
  organizationId String
  template       Json
  frequency      RecurringFrequency
  nextRunAt      DateTime
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Budget {
  id              String       @id @default(cuid())
  organizationId  String
  categoryId      String?
  amount          Int
  period          BudgetPeriod
  alertThresholds Int[]        @default([80, 100])
  startDate       DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id])

  @@index([organizationId])
}

model ExpenseReport {
  id              String       @id @default(cuid())
  organizationId  String
  employeeId      String
  title           String
  status          ReportStatus @default(BROUILLON)
  totalAmount     Int          @default(0)
  submittedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]
  approvals    Approval[]

  @@index([organizationId])
  @@index([employeeId])
}

model Approval {
  id        String         @id @default(cuid())
  reportId  String
  actorId   String
  action    ApprovalAction
  comment   String?
  createdAt DateTime       @default(now())

  report ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// Un seul abonnement courant par entreprise (organizationId @unique) : garder
// un historique ici obligerait chaque lecture a deviner lequel fait foi. Les
// paiements successifs vivent dans Payment, qui est le vrai historique.
model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  plan           SubscriptionPlan
  status         SubscriptionStatus @default(TRIALING)
  billingCycle   BillingCycle       @default(MONTHLY)

  // Nullable : pendant l'essai gratuit, aucun prestataire n'est encore choisi.
  provider PaymentProvider?

  // Fin de l'essai tant que status = TRIALING, fin de la periode payee ensuite.
  currentPeriodEnd DateTime

  // Pose a l'entree en PAST_DUE : 7 jours plus tard, l'acces passe en lecture
  // seule. Stocke plutot que recalcule, pour qu'un changement de politique ne
  // raccourcisse pas retroactivement le delai deja annonce a un client.
  graceEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]
}

// Une ligne par tentative de paiement : c'est a la fois la trace technique de
// la transaction et la facture presentee au client (PROJET.md section 4.5).
model Payment {
  id             String @id @default(cuid())
  organizationId String
  subscriptionId String

  // Notre reference, affichee comme numero de facture et dictee au client pour
  // qu'il l'inscrive en motif de son paiement Wave. Unique : c'est le seul fil
  // qui relie un virement recu sur le portefeuille marchand a l'entreprise qui
  // l'a emis (PROJET.md section 9).
  reference String @unique

  provider     PaymentProvider
  plan         SubscriptionPlan
  billingCycle BillingCycle
  amount       Int // FCFA, entier (PROJET.md section 6)
  status       PaymentStatus   @default(PENDING)

  // INUTILISEES. Ajoutees le 16 aout 2026 pour une integration d'agregateur
  // (facture a token + page de paiement hebergee) qui a ete abandonnee. Aucun
  // code ne les lit ni ne les ecrit, et elles sont NULL sur toutes les lignes.
  // Conservees plutot que supprimees : les retirer demande une migration
  // destructive pour un gain nul, et elles resserviraient telles quelles le
  // jour ou un vrai prestataire d'API sera branche.
  providerInvoiceToken String? @unique
  providerCheckoutUrl  String?

  // Identifiant de transaction Wave (TAxxx), recopie par le client depuis son
  // recu au moment ou il declare avoir paye. C'est la piece a rapprocher du
  // portefeuille marchand avant validation — declaratif, donc sans confiance
  // tant qu'un humain ne l'a pas verifie.
  providerTransactionId String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([subscriptionId])
}

// Compteur des scans OCR (PROJET.md section 11 : 20 / 200 / illimite par mois).
// On compte les APPELS a l'API Gemini, pas les recus conserves : c'est le cout
// de l'appel que le quota protege, et un utilisateur qui scanne sans
// enregistrer le consomme quand meme.
model OcrUsage {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String
  entity         String
  entityId       String?
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
